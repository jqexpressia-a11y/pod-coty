{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://podcity.local/schemas/pod-task.schema.json",
  "title": "Pod Bridge Task",
  "description": "A repository-mediated task pod written by Manus and consumed by Claude Code.",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "title",
    "status",
    "created_by",
    "created_at",
    "acceptance_criteria"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,80}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": ["queued", "active", "completed", "failed", "skipped"]
    },
    "created_by": {
      "type": "string",
      "minLength": 2
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "med", "normal", "high", "urgent"]
    },
    "spec_file": {
      "type": "string",
      "minLength": 1
    },
    "spec": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "branch": {
      "type": "string",
      "minLength": 3
    },
    "spec_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "implementation_notes": {
      "type": "string"
    },
    "result": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": "string"
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "run_id": { "type": "string" },
            "root": { "type": "string" },
            "manifest": { "type": "string" },
            "files": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "deployment_trigger_verified": {
          "type": "boolean"
        }
      }
    }
  }
}
