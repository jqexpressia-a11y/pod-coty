# Copy to .env.local and fill in your keys
ANTHROPIC_API_KEY=sk-ant-...

# Spotify integration (optional)
# Create an app at https://developer.spotify.com/dashboard
# Set redirect URI to: http://127.0.0.1:<any-port>/callback
SPOTIFY_CLIENT_ID=

# Obsidian vault browser (optional)
# Absolute path to your Obsidian vault folder
OBSIDIAN_VAULT_PATH=

# Journal storage directory (optional — defaults to userData/journal)
# Entries are stored in SQLite; this setting is reserved for future file-export use
# JOURNAL_DIR=

# Free Claude Code proxy (optional)
# Run fcc-server locally: https://github.com/anthropics/freecc
# Then switch the provider toggle in the sidebar to "FCC"
FCC_PROXY_URL=http://127.0.0.1:8082
